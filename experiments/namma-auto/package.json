    "@fontsource/rozha-one": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
